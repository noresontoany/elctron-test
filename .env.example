COMPOSE_PROJECT_NAME=spoke-demo
APP_PORT=8097
APP_TLS_PORT=8447
APP_EXTRA_ORIGINS=https://localhost:8447,https://127.0.0.1:8447
SYNC_MAX_CONNECTIONS=128
SYNC_ADMISSION_TIMEOUT=0.25
APP_ORIGIN=http://localhost:8097
POSTGRES_DB=spoke
POSTGRES_USER=spoke
POSTGRES_PASSWORD=replace-with-random-postgres-secret
SESSION_SECRET=replace-with-random-local-secret
ELECTRIC_SECRET=replace-with-random-electric-secret
